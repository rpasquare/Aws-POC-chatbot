# Required. The process refuses to start without these.
DATABASE_URL=postgresql://deal:deal@localhost:5433/deal_workspace
AWS_REGION=us-east-1
S3_BUCKET=deal-workspace-dev
EXTRACTION_SERVICE_URL=http://localhost:8001

# Optional until the resources exist. Leave all three unset and the API
# starts with PII masking off. Set all three together to turn it on.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
# PII_KMS_KEY_ID=

# Local object storage emulation only. Leave unset against real S3.
# S3_ENDPOINT_URL=http://localhost:9000

# Optional overrides, defaults shown.
# MAX_UPLOAD_BYTES=104857600
# EXTRACTION_POLL_SECONDS=2
# EXTRACTION_POLL_TIMEOUT_SECONDS=600
# PAGE_IMAGE_DPI=110
# RELEVANCE_THRESHOLD=0.02
# LOG_LEVEL=INFO
# SESSION_EXPIRY_SECONDS=2592000

# The app default is true. Browsers accept a Secure cookie on
# http://localhost, and reject it on plain http://PUBLIC_IP. The shared
# site is HTTP on port 8080, and Compose defaults this to false there.
# Set true only after the site is served over HTTPS.
# SESSION_COOKIE_SECURE=false

# Invite emails. 'smtp' (default) points at Mailpit so no real email is
# sent while developing. Inside Compose, SMTP_HOST is mailpit. A process
# started with run_api.sh on the host should use localhost.
# Switch EMAIL_BACKEND to ses when invites should go out for real.
# EMAIL_BACKEND=smtp
# EMAIL_FROM_ADDRESS=invites@deal-workspace.local
# SMTP_HOST=localhost
# SMTP_PORT=1025
# FRONTEND_BASE_URL=http://localhost:5174
