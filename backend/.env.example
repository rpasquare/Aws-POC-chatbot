# Required. The process refuses to start without these.
DATABASE_URL=postgresql://deal:deal@localhost:5433/deal_workspace
AWS_REGION=us-east-1
S3_BUCKET=deal-workspace-dev
EXTRACTION_SERVICE_URL=http://localhost:8001

# Local object storage emulation only. Leave unset against real S3.
# S3_ENDPOINT_URL=http://localhost:9000

# Optional overrides, defaults shown.
# MAX_UPLOAD_BYTES=104857600
# EXTRACTION_POLL_SECONDS=2
# EXTRACTION_POLL_TIMEOUT_SECONDS=600
# PAGE_IMAGE_DPI=110
# RELEVANCE_THRESHOLD=0.02
# LOG_LEVEL=INFO
